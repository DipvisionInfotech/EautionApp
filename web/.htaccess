# ==============================================================================
# Hostinger Caching & Flutter Single Page Application (SPA) Routing
# ==============================================================================

<IfModule mod_headers.c>
    # 1. Disable browser & CDN caching for HTML and JSON metadata files
    <FilesMatch "\.(html|json)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 2. Revalidate bootstrap script immediately
    <FilesMatch "(flutter_bootstrap\.js)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 3. Cache static media assets (images, icons, fonts)
    <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=3600"
    </FilesMatch>
</IfModule>

# 4. Fallback route all unknown URLs to index.html for Flutter Web routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
