# ==============================================================================
# Hostinger LiteSpeed Web Server & Flutter Single Page Application (SPA) Routing
# ==============================================================================

# 1. Completely disable LiteSpeed server-level cache for HTML and app entrypoints
<IfModule LiteSpeed>
    CacheDisable
</IfModule>

<IfModule mod_headers.c>
    # 2. Disable all browser & CDN caching for HTML and JSON metadata files
    <FilesMatch "\.(html|json)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store, must-revalidate"
        Header set X-Cache-Control "no-cache"
    </FilesMatch>

    # 3. Disable caching for bootstrap loader and service worker killswitch
    <FilesMatch "(flutter_bootstrap\.js|flutter_service_worker\.js)$">
        FileETag None
        Header unset ETag
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store, must-revalidate"
        Header set X-Cache-Control "no-cache"
    </FilesMatch>

    # 4. Cache static media assets (images, icons, fonts)
    <FilesMatch "\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=3600"
    </FilesMatch>
</IfModule>

# 5. Fallback route all unknown URLs to index.html for Flutter Web client routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
